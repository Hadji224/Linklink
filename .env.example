# Copiez ce fichier en « .env » (ou renseignez ces variables chez votre hébergeur).
PORT=3000
NODE_ENV=production
# Base de données PostgreSQL (obligatoire). Neon : copier l'adresse « Connection string » du projet (sslmode=require).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Dossier local : copies temporaires des envois, journaux d'accès (et fichiers si Google Drive n'est pas configuré)
DATA_DIR=/data
# Stockage des fichiers dans Google Drive (voir docs/stockage-google-drive.md). Sans ces trois variables : disque local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Nom du dossier créé dans le Drive (facultatif)
GOOGLE_DRIVE_FOLDER_NAME=LinkLink
# true si le serveur est derrière un proxy HTTPS (Caddy, Nginx, Render…)
TRUST_PROXY=true
# Secret de signature des sessions : une longue chaîne aléatoire (openssl rand -hex 48). Sinon généré et stocké dans la base.
JWT_SECRET=
# Taille maximale d'un fichier déposé, en Mo
MAX_UPLOAD_MB=25
# Place maximale par personne (Mo) pour l'ensemble de ses fichiers
USER_QUOTA_MB=1000

# PREMIER COMPTE : sur un serveur hébergé (Render, Vercel…), l'inscription du premier compte (Administrateur technique)
# exige ce secret ; sans lui elle est verrouillée. Une longue chaîne aléatoire (openssl rand -hex 24), à communiquer
# oralement à la personne qui crée le compte, jamais par écrit dans le dépôt.
BOOTSTRAP_SECRET=
# Durée de validité des codes d'invitation (jours)
INVITE_TTL_DAYS=30
# Anti force brute (valeurs par défaut) : échecs tolérés par adresse IP / par compte sur la fenêtre, requêtes d'authentification par IP
AUTH_WINDOW_MIN=15
AUTH_FAIL_LIMIT_IP=20
AUTH_FAIL_LIMIT_ACCOUNT=8
AUTH_REQ_LIMIT_IP=150

# Pièces jointes des salons : relais temporaire en base (modèle WhatsApp), les appareils gardent leur copie.
# Conservation sur le serveur (jours), taille maximale par pièce jointe (Mo), place maximale occupée en base (Mo).
CHAT_FILE_RETENTION_DAYS=30
CHAT_MAX_FILE_MB=10
CHAT_STORE_BUDGET_MB=300
# Adresse publique de l'application (liens dans les e-mails)
APP_URL=https://linklink.exemple.com
# E-mails de notification (facultatif) : sans SMTP_URL, seules les notifications dans l'application sont envoyées
SMTP_URL=
MAIL_FROM="LinkLink <no-reply@linklink.exemple.com>"
# Interface hébergée séparément (ex. Vercel) : origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGIN=
# Côté interface (variable de build, ex. sur Vercel) : VITE_API_URL=https://linklink-api.onrender.com
