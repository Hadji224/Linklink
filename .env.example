# Copiez ce fichier en « .env » (ou renseignez ces variables chez votre hébergeur).
PORT=3000
NODE_ENV=production
# Dossier de la base SQLite, des fichiers déposés, des sauvegardes et des logs (disque persistant !)
DATA_DIR=/data
# true si le serveur est derrière un proxy HTTPS (Caddy, Nginx, Render…)
TRUST_PROXY=true
# Secret de signature des sessions : une longue chaîne aléatoire (openssl rand -hex 48). Sinon généré et stocké dans la base.
JWT_SECRET=
# Taille maximale d'un fichier déposé, en Mo
MAX_UPLOAD_MB=25
# Adresse publique de l'application (liens dans les e-mails)
APP_URL=https://linklink.exemple.com
# E-mails de notification (facultatif) : sans SMTP_URL, seules les notifications dans l'application sont envoyées
SMTP_URL=
MAIL_FROM="LinkLink <no-reply@linklink.exemple.com>"
